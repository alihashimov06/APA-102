@model ProductDetailVM
<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Product Details: @Model.Name</h4>

                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th>ID</th>
                                    <td>@Model.Id</td>
                                </tr>
                                <tr>
                                    <th>Name</th>
                                    <td>@Model.Name</td>
                                </tr>
                                <tr>
                                    <th>Price</th>
                                    <td>$@Model.Prize</td>
                                </tr>
                                <tr>
                                    <th>SKU</th>
                                    <td>@Model.SKU</td>
                                </tr>
                                <tr>
                                    <th>Category</th>
                                    <td>
                                        <span class="badge badge-success" style="color:black">
                                            @Model.CategoryName
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Description</th>
                                    <td>@Model.Description</td>
                                </tr>

                                <tr>
                                    <th>Tags</th>
                                    <td>
                                        @if (Model.Tags.Count > 0)
                                        {
                                            @foreach (string tag in Model.Tags)
                                            {
                                                <span class="badge badge-info me-1"
                                                      style="color:black; background-color:#d1ecf1;">
                                                    @tag
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Sizes</th>
                                    <td>
                                        @if (Model.Sizes != null && Model.Sizes.Count > 0)
                                        {
                                            @foreach (var item in Model.Sizes)
                                            {
                                                <span class="badge badge-info me-1" style="color:black; background-color:#d1ecf1;">
                                                    @item.Size.Name
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-md-6">
                        <h5>Product Images</h5>

                        @if (!string.IsNullOrEmpty(Model.MainImage))
                        {
                            <div class="mb-3">
                                <strong>Main Image</strong>
                                <img src="~/assets/images/website-images/@Model.MainImage"
                                     style="width:100%;max-height:250px;object-fit:contain" />
                            </div>
                        }

                        <div class="row">
                            @foreach (string img in Model.AdditionalImages)
                            {
                                <div class="col-4 mb-3">
                                    <img src="~/assets/images/website-images/@img"
                                         style="width:100%;height:120px;object-fit:contain" />
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Close</a>
                </div>
            </div>
        </div>
    </div>
</div>
